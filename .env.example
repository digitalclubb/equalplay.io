# Copy to .env.local (gitignored) and fill in from your Supabase project settings.
#
# Never write .env.local from a script. To build or preview against throwaway
# credentials use `pnpm preview:demo`, which passes them inline and leaves your
# real .env.local alone.

# Client. Shipped in the browser bundle. Public by design: row level security
# is the boundary, not secrecy.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server only, for api/delete-account.ts. NEVER give this a VITE_ prefix. That
# would publish a key that bypasses every row level security policy.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
