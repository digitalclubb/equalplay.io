{
  "name": "equalplay.io",
  "version": "1.0.0",
  "description": "A rugby coaching app for minis and junior coaches, U7 to U12",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:demo": "VITE_SUPABASE_URL=https://example.supabase.co VITE_SUPABASE_ANON_KEY=demo-anon-key vite build && vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "oxlint src/ api/",
    "generate-icons": "tsx scripts/generate-icons.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.3",
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^26.2.0",
    "jsdom": "^29.0.0",
    "oxlint": "^1.56.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.3",
    "@vercel/analytics": "^2.0.1"
  }
}
